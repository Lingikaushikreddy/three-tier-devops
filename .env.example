# Copy to .env and edit:  cp .env.example .env
# .env is gitignored — real credentials must never be committed.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-real-life
POSTGRES_DB=tasks

# Host port for the site. Change if 8080 is already taken on your machine.
WEB_PORT=8080

APP_VERSION=1.0.0
