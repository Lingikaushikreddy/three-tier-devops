    {
      "type": "timeseries",
      "title": "PostgreSQL connections",
      "description": "Connection pools leak. This is how you find out before the database refuses new clients.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (datname) (pg_stat_database_numbackends{datname=\"tasks\"})",
          "legendFormat": "{{datname}}",
          "refId": "A"
